# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hdpm

# Payload CMS
PAYLOAD_SECRET=your-random-secret-at-least-32-chars-long

# AppFolio API
APPFOLIO_CLIENT_NAME=highdesertpm
APPFOLIO_API_KEY=your-appfolio-api-key

# Email
RESEND_API_KEY=your-resend-api-key

# Supabase Storage (S3-compatible — generate keys in Supabase Dashboard > Storage > S3 Connection)
S3_BUCKET=media
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=us-east-2

# Lead notifications (Resend). Sender domain must be verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@highdesertpm.com
LEAD_FROM_EMAIL="HDPM Website <leads@highdesertpm.com>"

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset = GA disabled.
NEXT_PUBLIC_GA_ID=

# SEO agent — Google Search Console service account (see src/lib/seo-agent/gsc.ts).
# Unset = the weekly cron no-ops. Requires Search Console verification first.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:highdesertpm.com

# Site
# Production must be https://www.highdesertpm.com (www is the canonical host).
# No trailing whitespace/newline — it feeds canonicals, og:url, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konmashi
KONMASHI_API_SECRET=your-konmashi-secret

# ISR Revalidation
REVALIDATION_SECRET=your-revalidation-secret

# Owner Rental Analysis form
GOOGLE_PLACES_API_KEY=your-google-maps-api-key
RENTCAST_API_KEY=your-rentcast-api-key  # optional; degrades gracefully

# Service-to-service comms with hdpm-chatbot (rental analysis intake)
HDPM_CHATBOT_BASE_URL=https://chatbot.highdesertpm.com
HDPM_SERVICE_TOKEN=shared-bearer-token-set-the-same-in-both-apps
