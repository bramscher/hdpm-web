# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hdpm

# Payload CMS
PAYLOAD_SECRET=your-random-secret-at-least-32-chars-long

# AppFolio API
APPFOLIO_CLIENT_NAME=highdesertpm
APPFOLIO_API_KEY=your-appfolio-api-key

# Email
RESEND_API_KEY=your-resend-api-key

# Supabase Storage (S3-compatible — generate keys in Supabase Dashboard > Storage > S3 Connection)
S3_BUCKET=media
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=us-east-2

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konmashi
KONMASHI_API_SECRET=your-konmashi-secret

# ISR Revalidation
REVALIDATION_SECRET=your-revalidation-secret
